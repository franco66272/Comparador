FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements_universal.txt .
RUN pip install --no-cache-dir -r requirements_universal.txt
COPY . .
CMD ["python","verificar_precios_continuo.py","--cada-minutos","15","--lote","120","--workers","8","--horas","12"]
